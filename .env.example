# Allowed values: development | test
ENVIRONMENT=development

# DATABASE_URL is computed from the variables below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=School_Management_System_Lite
DB_PASSWORD=musleno

# DB_POOL_TIMEOUT  = seconds to wait for a connection from the pool
# DB_CONNECT_TIMEOUT = seconds to wait for asyncpg to establish a PostgreSQL connection
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10