# Allowed values: development | test
ENVIRONMENT=development

# DATABASE_URL is computed from the variables below.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=School_Management_System_Lite
DB_PASSWORD=musleno

# DB_POOL_TIMEOUT  = seconds to wait for a connection from the pool
# DB_CONNECT_TIMEOUT = seconds to wait for asyncpg to establish a PostgreSQL connection
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10

# Signs and verifies all JWT tokens.
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key

# Access tokens should remain short-lived; refresh tokens provide session continuity.
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=15

RESEND_API_KEY=your_resend_api_key
MAIL_FROM=onboarding@resend.dev
MAIL_FROM_NAME=SMS Lite
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=587
MAILTRAP_USERNAME=your_mailtrap_sandbox_username
MAILTRAP_PASSWORD=your_mailtrap_sandbox_password